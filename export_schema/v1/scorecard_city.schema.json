{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-forecast-audit.example/export_schema/v1/scorecard_city.schema.json",
  "title": "scorecard_city",
  "description": "One station's live scorecard stats over the same window as scorecard.json. `stats` is empty when the station has no graded logged predictions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "icao",
    "label",
    "window",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "icao": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "window": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/window"
        }
      ],
      "description": "Null when no logged prediction has been graded yet."
    },
    "stats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stat"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "basis",
        "start",
        "end"
      ],
      "description": "The inclusive window of target_dates scored: `days` consecutive dates ending at the latest target_date with a scorable observation among logged keys.",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "const": "target_date"
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date",
          "description": "First target_date in the window (YYYY-MM-DD, inclusive)."
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date",
          "description": "Last target_date in the window (YYYY-MM-DD, inclusive)."
        }
      }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "description": "One variable x lead_day x source slice over the window. Intervals are date-block bootstrap percentile intervals at the file's `intervals.level`; `skill` is 1 - MAE/MAE_raw on matched pairs (0.0 for raw_nbm itself). `min_sample_flag` true means too few bootstrap blocks for a significance call.",
      "required": [
        "variable",
        "lead_day",
        "source",
        "n",
        "n_dates",
        "n_blocks",
        "mae_f",
        "mae_lo_f",
        "mae_hi_f",
        "bias_f",
        "bias_lo_f",
        "bias_hi_f",
        "skill",
        "skill_lo",
        "skill_hi",
        "min_sample_flag",
        "no_detectable_bias"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "enum": [
            "max",
            "min"
          ]
        },
        "lead_day": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "raw_nbm",
            "baseline",
            "challenger"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "n_dates": {
          "type": "integer",
          "minimum": 1
        },
        "n_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "mae_f": {
          "type": "number",
          "minimum": 0
        },
        "mae_lo_f": {
          "type": [
            "number",
            "null"
          ]
        },
        "mae_hi_f": {
          "type": [
            "number",
            "null"
          ]
        },
        "bias_f": {
          "type": "number"
        },
        "bias_lo_f": {
          "type": [
            "number",
            "null"
          ]
        },
        "bias_hi_f": {
          "type": [
            "number",
            "null"
          ]
        },
        "skill": {
          "type": [
            "number",
            "null"
          ]
        },
        "skill_lo": {
          "type": [
            "number",
            "null"
          ]
        },
        "skill_hi": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_sample_flag": {
          "type": "boolean"
        },
        "no_detectable_bias": {
          "type": "boolean"
        }
      }
    }
  }
}
